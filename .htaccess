# Apache configuration for AUGHS Website
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /aughs/

    # Allow direct access to existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map /contact-2 or /contact-2/ to contact-2.php
    RewriteRule ^contact-2/?$ contact-2.php [L,QSA]

    # Map /[slug]/ or /[slug] to [slug].php if file exists
    RewriteCond %{DOCUMENT_ROOT}/aughs/$1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L,QSA]
</IfModule>

# Options
Options -Indexes
